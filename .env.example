# =============================================================================
# SynapseOS Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=SynapseOS
APP_ENV=development  # development, staging, production, testing
APP_DEBUG=true       # MUST be false in production (enforced by startup validation)
APP_PORT=8000
APP_HOST=0.0.0.0
# Generate with: openssl rand -hex 32. In production, must NOT be default and >= 16 chars.
APP_SECRET_KEY=change-me-to-a-random-secret-key
APP_LOG_LEVEL=INFO
# Storage Mode: 'local_embedded' (zero external dependencies), 'auto' (detect services), 'distributed' (strict)
STORAGE_MODE=auto
# Gating for /docs and /redoc (always disabled in production unless explicitly set to true)
ENABLE_DOCS_IN_PRODUCTION=false

# =============================================================================
# Frontend (Public Browser Environment Variables - NEVER put secrets here!)
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_NAME=SynapseOS

# =============================================================================
# Database - PostgreSQL
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=synapseos
POSTGRES_USER=synapseos
POSTGRES_PASSWORD=synapseos_dev_password
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================================================
# Vector Database - Qdrant
# =============================================================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=synapseos

# =============================================================================
# Graph Database - Neo4j
# =============================================================================
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=synapseos_dev_password
NEO4J_DATABASE=synapseos

# =============================================================================
# Cache - Redis
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =============================================================================
# =============================================================================
# Nebius Token Factory & NVIDIA Nemotron (Primary Inference Engine)
# =============================================================================
NEBIUS_API_KEY=your-nebius-token-factory-api-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-4-340b-instruct
NEBIUS_TIMEOUT_SECONDS=60.0
PRIVACY_MODE=hybrid  # hybrid (recommended), local_only, or cloud_only

# Local LLM Fallback (Ollama)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2

# Optional Cloud Fallbacks (LiteLLM)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Default provider: "nebius" (default), "local", or "cloud"
LLM_DEFAULT_PROVIDER=nebius

# =============================================================================
# Embeddings
# =============================================================================
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# =============================================================================
# MCP (Model Context Protocol)
# =============================================================================
MCP_SERVER_PORT=3100

# =============================================================================
# Authentication
# =============================================================================
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7
JWT_COOKIE_NAME=synapseos_session
JWT_COOKIE_DOMAIN=

# =============================================================================
# Monitoring
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
SENTRY_DSN=

# =============================================================================
# Development
# =============================================================================
PYTHONPATH=/app
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
