# =============================================================================
# SynapseOS — Production Environment
# =============================================================================
# WARNING: Replace ALL secret values before deploying to production.
# This file should be managed by your deployment platform, NOT committed to git.

APP_NAME=SynapseOS
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY
APP_LOG_LEVEL=WARNING
APP_LOG_FORMAT=json

# PostgreSQL — Use a managed service or secure connection
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=synapseos
POSTGRES_USER=synapseos
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME
NEO4J_DATABASE=synapseos

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=synapseos

# LLM
LLM_DEFAULT_PROVIDER=local
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=CHANGE_ME
ANTHROPIC_API_KEY=CHANGE_ME

# CORS — Set to your production domain
CORS_ORIGINS=["https://your-domain.com"]
