# =============================================================================
# SynapseOS — Production Environment Template
# =============================================================================
# WARNING: Replace ALL secret values before deploying to production.
# Generate 256-bit secrets via: openssl rand -hex 32
# This file should be managed by your deployment platform, NOT committed to git.

APP_NAME=SynapseOS
APP_ENV=production
APP_DEBUG=false
APP_PORT=8000
APP_SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32_APP_SECRET
JWT_SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32_JWT_SECRET
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=json
STORAGE_MODE=local_embedded
ENABLE_DOCS_IN_PRODUCTION=false

# CORS — Set to your trusted frontend domain(s)
CORS_ORIGINS=["https://app.synapseos.internal", "http://localhost:3000"]

# Frontend (Public browser variables)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
WEB_PORT=3000

# Nebius Token Factory & NVIDIA Nemotron (Leave key empty for simulation mode)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF
PRIVACY_MODE=hybrid

# Distributed Mode Dependencies (Only required when STORAGE_MODE=distributed)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=synapseos
POSTGRES_USER=synapseos
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_STRONG_NEO4J_PASSWORD
NEO4J_DATABASE=synapseos

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=synapseos

LLM_DEFAULT_PROVIDER=nebius
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2

