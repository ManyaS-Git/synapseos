# =============================================================================
# SynapseOS — Development Environment
# =============================================================================
APP_NAME=SynapseOS
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=dev-secret-key-do-not-use-in-production
APP_LOG_LEVEL=DEBUG
APP_LOG_FORMAT=console

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=synapseos
POSTGRES_USER=synapseos
POSTGRES_PASSWORD=synapseos_dev_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=synapseos_dev_password
NEO4J_DATABASE=synapseos

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=synapseos

# LLM
LLM_DEFAULT_PROVIDER=local
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# JWT
JWT_SECRET_KEY=dev-jwt-secret-do-not-use-in-production
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7
JWT_COOKIE_NAME=synapseos_session

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
